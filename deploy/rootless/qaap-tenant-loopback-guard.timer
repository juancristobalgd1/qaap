# Installed by scripts/qaap-vps-update.sh. Re-asserts the guard so a firewall reload (ufw,
# iptables-restore) that drops the chain or moves its jump is repaired within a minute.
[Unit]
Description=Re-assert the Qaap tenant loopback guard

[Timer]
OnBootSec=1min
OnUnitActiveSec=1min
AccuracySec=10s

[Install]
WantedBy=timers.target
