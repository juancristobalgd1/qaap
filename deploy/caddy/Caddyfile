# Public TLS terminator for Qaap. Theia stays on the compose network / localhost.
# Set QAAP_PUBLIC_HOST to ONE hostname with public DNS (sslip.io works for bare VPS IPs):
#   QAAP_PUBLIC_HOST=161.97.69.219.sslip.io
#   QAAP_OAUTH_PUBLIC_URL=https://161.97.69.219.sslip.io
# Extra hostnames go in QAAP_PUBLIC_ALIAS_HOSTS (comma-separated), never in QAAP_PUBLIC_HOST.

# Shared site body: the canonical host and its optional aliases serve the same app.
(qaap_app) {
	encode zstd gzip
	# Keep baseline browser hardening on local and public deployments.
	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
	# HSTS is only emitted for non-local hosts so local HTTP development is not
	# pinned to HTTPS by a previous browser visit.
	@public not host localhost 127.0.0.1 ::1
	header @public Strict-Transport-Security "max-age=31536000"
	# Cap request bodies so one client cannot stream unbounded uploads into the shared backend.
	# Generous by default (uploads, attachments); override with QAAP_REQUEST_BODY_MAX_SIZE.
	request_body {
		max_size {$QAAP_REQUEST_BODY_MAX_SIZE:512MB}
	}
	reverse_proxy theia:{$THEIA_PORT:4873}
}

# One host only: staging.caddy derives staging.<host> from it.
{$QAAP_PUBLIC_HOST:localhost} {
	import qaap_app
}

# Extra hostnames for the same app (e.g. the old <ip>.sslip.io after moving to a real domain), so
# bookmarks, webhooks and deploy probes keep working. Imported only when QAAP_PUBLIC_ALIAS_HOSTS is
# set (see docker-compose.yml); an unmatched import glob is not an error.
import /etc/caddy/aliases/{$QAAP_PUBLIC_ALIAS_SITE:disabled}.caddy*

# Isolated preview origins (optional). The glob matches nothing unless QAAP_PREVIEW_CADDY_SITE is
# set (see docker-compose.yml), and an unmatched import glob is not an error.
import /etc/caddy/previews/{$QAAP_PREVIEW_CADDY_SITE:disabled}.caddy*

# Staging site (ops/STAGING.md). The staging workflow copies staging.caddy into staging-enabled/
# and reloads Caddy; the folder is empty otherwise, and an unmatched import glob is not an error.
import /etc/caddy/staging-enabled/*.caddy
