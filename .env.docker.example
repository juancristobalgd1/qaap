# Copy to `.env` next to docker-compose.yml on your VPS (e.g. /opt/qaap/.env).
#
#   cp .env.docker.example .env
#   # edit QAAP_OAUTH_PUBLIC_URL and GitHub OAuth app callback
#   docker compose up --build -d

# Host port published to the internet (IDE listens on the same port inside the container).
THEIA_PORT=4873

# REQUIRED to log in: set up EITHER a GitHub OAuth app (the three vars below) OR QAAP_SKIP_AUTH=true.
# With neither, there is no way to sign in — the login screen shows "GitHub sign-in unavailable".
# QAAP_OAUTH_PUBLIC_URL must match how users reach Qaap (GitHub OAuth redirects + dev preview URLs).
# Example: http://178.105.136.93:4873
QAAP_OAUTH_PUBLIC_URL=

# GitHub OAuth app (https://github.com/settings/developers). Callback: <QAAP_OAUTH_PUBLIC_URL>/qaap/oauth/github/callback
QAAP_GITHUB_CLIENT_ID=
QAAP_GITHUB_CLIENT_SECRET=

# Set true to skip GitHub sign-in (LOCAL / single-user only — refused in a production runtime).
QAAP_SKIP_AUTH=false

# Web Push (generate with: npx web-push generate-vapid-keys)
QAAP_VAPID_PUBLIC_KEY=
QAAP_VAPID_PRIVATE_KEY=
QAAP_VAPID_SUBJECT=mailto:you@example.com

# Background coding agents. The Docker image builds QAIQ (github.com/juancristobalgd1/qaiq)
# and installs current Codex, Claude Code, Antigravity CLI, OpenCode, Copilot CLI, and Grok Build.
# It auto-detects
# `codex`, `claude`, `qaiq`, `grok`, `opencode`, `goose`,
# `hermes`, `openclaw`, `cursor-agent`, `antigravity`, `copilot`, `qwen`, and `kimi` on PATH.
# Set provider API keys in this file using the env vars expected by that CLI.
#
# Default background agent (Docker image also sets qaiq as default).
QAAP_DEFAULT_AGENT=qaiq

# Agent-independent job runtime. These limits are enforced by the backend scheduler, even when
# several browsers or automation clients submit work concurrently.
QAAP_JOB_MAX_CONCURRENT=8
QAAP_JOB_MAX_CONCURRENT_PER_USER=4
QAAP_JOB_LIMIT_CPU=2
QAAP_JOB_LIMIT_IO=8
QAAP_JOB_LIMIT_NETWORK=4
QAAP_JOB_LIMIT_WORKSPACE=4
QAAP_JOB_LIMIT_DEPLOYMENT=1
QAAP_JOB_MAX_TIMEOUT_MS=7200000
QAAP_JOB_MAX_LOG_CHARS=524288
QAAP_JOB_LOOP_MAX_JOBS=512
QAAP_JOB_LOOP_MAX_ACTIVE_PER_USER=4
QAAP_JOB_LOOP_TRIGGER_LEASE_TTL_MS=600000
QAAP_JOB_LOOP_MANAGEMENT_LOCK_TTL_MS=30000
QAAP_JOB_LOOP_MANAGEMENT_LOCK_TIMEOUT_MS=5000

# CLI versions installed at Docker build time. Codex is pinned so Docker layer caching cannot
# silently keep an older `latest`; bump the exact version deliberately when upgrading it.
# The same vars are also passed at runtime as a fallback target for the boot "Update Available"
# toast when the npm registry is unreachable. Prefer leaving CLAUDE/OPENCODE/… as `latest` so
# the toast compares against the live registry.
CODEX_CLI_VERSION=0.144.5
CLAUDE_CODE_VERSION=latest
ANTIGRAVITY_CLI_VERSION=latest
OPENCODE_CLI_VERSION=latest
COPILOT_CLI_VERSION=latest
# Optional: force a QAIQ update toast when installed < this semver (QAIQ has no npm package).
# QAAP_QAIQ_MIN_VERSION=
# Set to 0/false/off to disable the agent CLI update probe entirely (air-gapped / CI).
# QAAP_AGENT_CLI_UPDATE_CHECK=1

# --- Provider API keys for @qaiq on the VPS (pick at least one) ---
# These are passed into the container and used when Settings → AI has no value yet.
# OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# GEMINI_API_KEY=
# GOOGLE_API_KEY=
# NVIDIA_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OLLAMA_HOST=http://host.docker.internal:11434
# HUGGINGFACE_API_KEY=
#
# Legacy single CLI template. The {prompt} placeholder receives the shell-quoted
# task description. Leave empty to use auto-detected agents and custom list below.
# Examples:
#   QAAP_AGENT_COMMAND=claude -p {prompt}
#   QAAP_AGENT_COMMAND=qaiq --bare --print --dangerously-skip-permissions {qaiq_flags} {prompt}
#   QAAP_AGENT_COMMAND=grok --always-approve -p {prompt}
QAAP_AGENT_COMMAND=

# Optional extra server-side agents as JSON. Use this to expose free-tier/BYOK
# providers through QAIQ, Aider, OpenAI-compatible endpoints, Ollama, OpenRouter,
# etc. QAAP maps known Settings keys into CLI env vars for background jobs.
# Example:
# QAAP_AGENT_COMMANDS=[{"id":"qaiq-gemini","label":"QAIQ Gemini","bin":"qaiq","template":"qaiq --print --dangerously-skip-permissions --provider gemini --model gemini-2.5-flash {prompt}"}]
QAAP_AGENT_COMMANDS=

# Optional: one Docker container per repo (requires Docker socket in the container)
# QAAP_CLOUD_MODE=docker

# --- Web search for @qaiq (SearXNG: free, no API key, bundled in docker-compose) ---
# The compose file ships a `searxng` service and defaults these so QAIQ's WebSearch
# uses it out of the box. Uncomment only to override. Removing/stopping the searxng
# service means WebSearch fails loudly (mode `custom` does not fall back to DuckDuckGo).
# WEB_SEARCH_PROVIDER=custom
# WEB_PROVIDER=searxng
# WEB_SEARCH_API=http://searxng:8080/search?format=json
# WEB_CUSTOM_ALLOW_PRIVATE=true
# WEB_CUSTOM_ALLOW_HTTP=true
# The SearXNG session secret lives in deploy/searxng/settings.yml (server.secret_key). Rotate it
# with `openssl rand -hex 32` if you like — it only signs sessions for the internal instance.
