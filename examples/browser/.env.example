# Copy to `examples/browser/.env` and fill in your own values. The real `.env` is gitignored — never
# commit secrets. These are LOCAL DEV credentials only; the production app runs on the VPS with its
# own environment (see docker-compose.yml / doc/qaap-vps-deployment.md).

# Visible IDE name (tab title, welcome, title bar). After first applying this template:
# `npm run build:browser` at the monorepo root; thereafter restart `npm run start:browser`.
# Leave empty to use `theia.frontend.config.applicationName` in package.json.
IDE_APPLICATION_NAME=Qaap

# Brand icon (favicon, logo next to the menu, secondary windows). Same build/restart rule as above.
IDE_APPLICATION_ICON=./media/qaap-logo.svg

# Skip the login screen locally (dev only). Restart `npm run start:browser` after changing.
QAAP_SKIP_AUTH=true

# GitHub OAuth for local dev. Create your own OAuth App at
# https://github.com/settings/developers with callback http://localhost:3000/qaap/oauth/github/callback
QAAP_GITHUB_CLIENT_ID=your-dev-oauth-client-id
QAAP_GITHUB_CLIENT_SECRET=your-dev-oauth-client-secret
QAAP_OAUTH_PUBLIC_URL=http://localhost:3000

# Web Push (VAPID). Generate your own with `npx web-push generate-vapid-keys` (dev only).
QAAP_VAPID_PUBLIC_KEY=your-dev-vapid-public-key
QAAP_VAPID_PRIVATE_KEY=your-dev-vapid-private-key
QAAP_VAPID_SUBJECT=mailto:you@example.com

# Folder where repos opened from the "Projects" panel are cloned.
# Default local: ~/.qaap/workspaces ; production: /workspace/repos (container mount).
# Uncomment to force another path.
# QAAP_REPOS_ROOT=/Users/you/.qaap/workspaces
