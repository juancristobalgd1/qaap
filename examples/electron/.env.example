# Copy to `examples/electron/.env` and fill in your own values. The real `.env` is gitignored —
# never commit secrets. LOCAL DEV credentials only.

IDE_APPLICATION_NAME=Qaap
# Electron native window: PNG (SVG is not supported as BrowserWindow.icon on all platforms).
IDE_APPLICATION_ICON=./resources/qaap-logo.png

# GitHub OAuth for local dev. Create your own at https://github.com/settings/developers
QAAP_GITHUB_CLIENT_ID=your-dev-oauth-client-id
QAAP_GITHUB_CLIENT_SECRET=your-dev-oauth-client-secret
QAAP_OAUTH_PUBLIC_URL=http://localhost:3000
