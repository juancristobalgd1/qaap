  "description": "Qaap — mobile shell mechanics: gestures, touch scroll, keyboard helper, bottom bar and narrow-viewport layout primitives (product layer)",
  "dependencies": {
    "@lumino/widgets": "2.7.5",
    "@theia/core": "1.73.0",
    "@theia/scm": "1.73.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "theiaExtensions": [
    {
      "frontend": "lib/browser/qaap-mobile-shell-frontend-module"
    }
  ],
  "keywords": [
