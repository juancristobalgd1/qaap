{
  "name": "@theia/qaap-mobile-shell",
  "version": "1.73.0",
  "description": "Qaap — narrow-viewport mobile shell contributions (product layer)",
  "dependencies": {
    "@lumino/algorithm": "^2.0.4",
    "@lumino/messaging": "^2.0.4",
    "@lumino/widgets": "2.7.5",
    "@theia/ai-chat": "1.73.0",
    "@theia/ai-chat-ui": "1.73.0",
    "@theia/ai-claude-code": "1.73.0",
    "@theia/ai-core": "1.73.0",
    "@theia/ai-ide": "1.73.0",
    "@theia/ai-mcp": "1.73.0",
    "@theia/core": "1.73.0",
    "@theia/filesystem": "1.73.0",
    "@theia/memory-inspector": "1.73.0",
    "@theia/mini-browser": "1.73.0",
    "@theia/monaco": "1.73.0",
    "@theia/navigator": "1.73.0",
    "@theia/outline-view": "1.73.0",
    "@theia/preferences": "1.73.0",
    "@theia/preview": "1.73.0",
    "@theia/qaap-adapters": "1.73.0",
    "@theia/qaap-ai-openrouter": "1.73.0",
    "@theia/qaap-element-inspector": "1.73.0",
    "@theia/qaap-shell": "1.73.0",
    "@theia/qaap-transcript-overlay": "1.73.0",
    "@theia/scm": "1.73.0",
    "@theia/terminal": "1.73.0",
    "@theia/vsx-registry": "1.73.0",
    "@theia/workspace": "1.73.0",
    "cron-parser": "^5.5.0",
    "linkedom": "^0.18.12",
    "tslib": "^2.8.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "theiaExtensions": [
    {
      "frontend": "lib/browser/qaap-workbench-frontend-module"
    },
    {
      "frontend": "lib/browser/qaap-mobile-shell-frontend-module"
    },
    {
      "backend": "lib/node/qaap-mobile-shell-backend-module"
    }
  ],
  "keywords": [
    "theia-extension"
  ],
  "license": "EPL-2.0 OR GPL-2.0-only WITH Classpath-exception-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/juancristobalgd1/theia.git"
  },
  "files": [
    "lib",
    "resources",
    "src"
  ],
  "scripts": {
    "build": "theiaext build",
    "clean": "theiaext clean",
    "precompile": "node scripts/qaap-llm-provider-icons-sync.js && node scripts/qaap-mcp-plugin-icons-sync.js",
    "compile": "theiaext compile",
    "sync:llm-provider-icons": "node scripts/qaap-llm-provider-icons-sync.js",
    "check:llm-provider-icons": "node scripts/qaap-llm-provider-icons-sync.js --check",
    "sync:mcp-plugin-icons": "node scripts/qaap-mcp-plugin-icons-sync.js",
    "check:mcp-plugin-icons": "node scripts/qaap-mcp-plugin-icons-sync.js --check",
    "lint": "theiaext lint",
    "test": "theiaext test",
    "watch": "theiaext watch"
  },
  "devDependencies": {
    "@theia/ext-scripts": "1.73.0"
  },
  "nyc": {
    "extends": "../../configs/nyc.json"
  }
}
