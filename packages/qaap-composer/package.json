  },
  "files": [
    "lib",
    "resources",
    "src"
  ],
  "scripts": {
    "build": "theiaext build",
    "clean": "theiaext clean",
    "precompile": "node scripts/qaap-mcp-plugin-icons-sync.js",
    "compile": "theiaext compile",
    "sync:mcp-plugin-icons": "node scripts/qaap-mcp-plugin-icons-sync.js",
    "check:mcp-plugin-icons": "node scripts/qaap-mcp-plugin-icons-sync.js --check",
    "lint": "theiaext lint",
    "test": "nyc mocha --config ../../configs/mocharc.yml --require ./test-support/ensure-jsdom.js \"./lib/**/*.*spec.js\"",
    "watch": "theiaext watch"
  },
  "devDependencies": {
    "@theia/ext-scripts": "1.73.0"
  },
  "nyc": {
    "extends": "../../configs/nyc.json"
  }
