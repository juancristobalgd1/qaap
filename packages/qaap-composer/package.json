  "dependencies": {
    "@lumino/widgets": "2.7.5",
    "@theia/ai-chat": "1.73.0",
    "@theia/ai-chat-ui": "1.73.0",
    "@theia/ai-core": "1.73.0",
    "@theia/ai-mcp": "1.73.0",
    "@theia/core": "1.73.0",
    "@theia/editor": "1.73.0",
    "@theia/filesystem": "1.73.0",
    "@theia/monaco": "1.73.0",
    "@theia/qaap-adapters": "1.73.0",
    "@theia/qaap-agents-ui": "1.73.0",
    "@theia/qaap-diff-review": "1.73.0",
    "@theia/qaap-mobile-mechanics": "1.73.0",
    "@theia/qaap-shared-core": "1.73.0",
    "@theia/qaap-transcript": "1.73.0",
    "@theia/qaap-transcript-overlay": "1.73.0",
    "@theia/workspace": "1.73.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "theiaExtensions": [],
  "keywords": [
    "theia-extension"
  ],
  "license": "EPL-2.0 OR GPL-2.0-only WITH Classpath-exception-2.0",
  "repository": {
    "type": "git",
